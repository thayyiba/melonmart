# Welp provider: gemini (default) or mock (offline/test mode)
MELONMART_CHAT_PROVIDER=mock

# Optional: enable Gemini-backed Welp chatbot
GEMINI_API_KEY=

# Optional database overrides. Configure these in your shell or hosting dashboard.
# Java does not automatically load this file. Back up existing data before switching URLs.
# On a host with persistent storage, uncomment and point this URL to the mounted disk.
# MELONMART_DB_URL="jdbc:h2:file:./data/melonmartdb;MODE=MySQL;AUTO_SERVER=TRUE"
# MELONMART_DB_USERNAME=sa
# MELONMART_DB_PASSWORD=

# Demo accounts contain publicly known credentials. Keep false on public deployments.
# Set true only for an isolated presentation/demo environment.
MELONMART_SEED_DEMO_DATA=false

# Optional first administrator when demo seeding is disabled.
# Use a unique email and a long password; never commit real secrets here.
MELONMART_ADMIN_NAME=Melon Mart Admin
MELONMART_ADMIN_EMAIL=
MELONMART_ADMIN_PASSWORD=
